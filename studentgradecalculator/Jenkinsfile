
pipeline {
    agent any

    stages {
        stage('Check Python') {
            steps {
                bat 'python --version'
            }
        }

        stage('Check Project File') {
            steps {
                bat 'dir'
            }
        }

        stage('Validate Code') {
            steps {
                bat 'python -m py_compile stud_grade.py'
            }
        }
    }
}
